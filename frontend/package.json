{
  "name": "@meetly/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "api:types": "openapi-typescript ../contracts/dist/openapi.yaml -o src/api/schema.d.ts",
    "dev": "vite",
    "dev:mock": "concurrently -n mock,vite -c cyan,green \"npm -w @meetly/contracts run mock\" \"vite\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@mantine/core": "^7.17.0",
    "@mantine/dates": "^7.17.0",
    "@mantine/form": "^7.17.8",
    "@mantine/hooks": "^7.17.0",
    "@mantine/notifications": "^7.17.8",
    "@tanstack/react-query": "^5.66.0",
    "dayjs": "^1.11.13",
    "i18next": "^26.4.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "openapi-fetch": "^0.13.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.12",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "openapi-typescript": "^7.6.1",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
